{
	"schemaVersion": 1,
	"id": "mdt",
	"version": "${version}",
	"name": "Minecraft Client Debug Toolkit",
	"description": "The mod includes several commands to help you access Minecraft. ",
	"icon": "assets/mdt/textures/icon.png",
	"authors": [
		"asablock"
	],
	"contact": {
		"homepage": "temporarily missing",
		"sources": "temporarily missing"
	},
	"license": "CC0-1.0",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.asablock.mdt.Mdt"
		]
	},
	"mixins": [
		{
			"config": "mdt.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "mdt.accesswidener",
	"depends": {
		"fabricloader": "*",
		"minecraft": ">=1.21.4",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"clientcommands": "*"
	}
}