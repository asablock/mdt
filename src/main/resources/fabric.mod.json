{
	"schemaVersion": 1,
	"id": "mdt",
	"version": "${version}",
	"name": "mdt",
	"description": "This is a pure-client mod which adds several features that may be useful.",
	"icon": "assets/mdt/textures/icon.png",
	"authors": [
		"asablock"
	],
	"contact": {
		"sources": "https://github.com/asablock/mdt"
	},
	"license": "GPL-3.0",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.asablock.mdt.Mdt"
		]
	},
	"mixins": [
		{
			"config": "mdt.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "mdt.accesswidener",
	"depends": {
		"fabricloader": "*",
		"minecraft": ">=1.21.4",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"clientcommands": "*"
	}
}